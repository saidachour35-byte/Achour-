{
  "appId": "com.achourplayer.app",
  "appName": "Achour Player",
  "webDir": "dist",
  "backgroundColor": "#080808",
  "server": {
    "androidScheme": "https",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#080808",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "CapacitorHttp": {
      "enabled": true
    }
  }
}
